<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Home</string>

    <!-- "Your apps" row, in this order. Missing or disabled packages are skipped. -->
    <string-array name="dock_apps">
        <item>com.google.android.youtube.tv</item>
        <item>com.cbs.ott</item>
        <item>com.edde746.plezy</item>
        <item>com.wbd.stream</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>com.spotify.tv.android</item>
    </string-array>

    <!-- Background photos: photos_album_url comes from the build (-PalbumUrl=, see app/build.gradle). -->
    <integer name="photo_seconds">30</integer>

    <!-- Weather in the top-right corner: a city name or postal code Open-Meteo can find.
         Empty uses the TV's approximate location from its IP address (ipapi.co). -->
    <string name="weather_city"></string>
    <!-- fahrenheit or celsius -->
    <string name="temperature_unit">fahrenheit</string>

    <!-- Continue watching: hide items not touched for this many days (apps leave stale rows behind). -->
    <integer name="continue_max_age_days">30</integer>
    <integer name="row_limit">20</integer>

    <!-- Subscriptions row: YouTube's preview channel with this name. -->
    <string name="subscriptions_package">com.google.android.youtube.tv</string>
    <string name="subscriptions_channel">Subscriptions</string>

    <!-- Live button: the TV app that plays the antenna tuner. -->
    <string name="live_package">com.tcl.tv</string>
</resources>
